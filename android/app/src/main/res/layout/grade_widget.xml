<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/grade_widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/brand_logo" android:contentDescription="Teach Assist logo"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEACH ASSIST" android:textColor="#2446BF" android:textStyle="bold" android:letterSpacing="0.12" android:textSize="11sp"/></LinearLayout>
<TextView android:id="@+id/widget_average" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:textColor="#172342" android:textStyle="bold" android:textSize="32sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="All-course average · unweighted" android:textColor="#626875" android:textSize="11sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="4dp" android:text="LATEST ASSESSMENTS" android:textColor="#2446BF" android:textStyle="bold" android:textSize="10sp"/>
<ListView android:id="@+id/widget_assessments" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="4dp"/>
<TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh grades in the app to load assessments." android:textColor="#626875" android:textSize="12sp"/>
<TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:textColor="#626875" android:textSize="10sp"/>
</LinearLayout>
